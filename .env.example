# LLM provider (OpenAI by default via @ai-sdk/openai)
OPENAI_API_KEY=

# Model IDs are config, not code: "provider:model-id", e.g. openai:<model-id>.
# Swap freely and compare with `pnpm eval`. Add providers in lib/models.ts.
CLASSIFIER_MODEL=
ANSWER_MODEL=
JUDGE_MODEL=

# Rate limiting (Upstash Redis from the Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: pin prompt versions (defaults live in lib/prompts/registry.ts)
# PROMPT_CLASSIFIER_VERSION=v1
# PROMPT_ANSWER_VERSION=v1
